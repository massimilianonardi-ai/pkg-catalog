macgpg_cmd_dir="${m_COMMAND_BIN%/*}"
[ "$macgpg_cmd_dir" != "$m_COMMAND_BIN" ] || return 1
macgpg_concrete_dir="${macgpg_cmd_dir%/*}"
[ "$macgpg_concrete_dir" != "$macgpg_cmd_dir" ] || return 1
macgpg_root="$macgpg_concrete_dir/root"

PATH="$macgpg_root/bin:$PATH"
DYLD_LIBRARY_PATH="$macgpg_root/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
export PATH DYLD_LIBRARY_PATH

unset macgpg_cmd_dir macgpg_concrete_dir macgpg_root

keycloak_cmd_dir="${m_COMMAND_BIN%/*}"
[ "$keycloak_cmd_dir" != "$m_COMMAND_BIN" ] || return 1
keycloak_concrete_dir="${keycloak_cmd_dir%/*}"
[ "$keycloak_concrete_dir" != "$keycloak_cmd_dir" ] || return 1

keycloak_java_provider=
IFS= read -r keycloak_java_provider < "$keycloak_concrete_dir/binding/java" || return 1
[ -n "$keycloak_java_provider" ] || return 1

JAVA_HOME="$m_PKG_DIR/$keycloak_java_provider/root"
[ -d "$JAVA_HOME" ] && [ ! -L "$JAVA_HOME" ] || return 1
[ -x "$JAVA_HOME/bin/java" ] || return 1
PATH="$JAVA_HOME/bin:$PATH"
export JAVA_HOME PATH

unset keycloak_cmd_dir keycloak_concrete_dir keycloak_java_provider

chromium_cmd_dir="${m_COMMAND_BIN%/*}"
[ "$chromium_cmd_dir" != "$m_COMMAND_BIN" ] || return 1
chromium_concrete_dir="${chromium_cmd_dir%/*}"
[ "$chromium_concrete_dir" != "$chromium_cmd_dir" ] || return 1

CHROME_DEVEL_SANDBOX="$chromium_concrete_dir/root/chrome_sandbox"
[ -f "$CHROME_DEVEL_SANDBOX" ] && [ ! -L "$CHROME_DEVEL_SANDBOX" ] && [ -x "$CHROME_DEVEL_SANDBOX" ] || return 1
export CHROME_DEVEL_SANDBOX

unset chromium_cmd_dir chromium_concrete_dir
